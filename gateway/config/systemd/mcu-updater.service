[Unit]
Description=MCU secure update service
Requires=tee-supplicant.service
Wants=LSS_gateway.service
After=tee-supplicant.service LSS_gateway.service
Before=mcu-update-swupdate.service
ConditionPathExists=/run/media/mmcblk0p6/mcu-update/bin/mcu-updater
ConditionPathIsMountPoint=/run/media/mmcblk0p6

[Service]
Type=simple
RuntimeDirectory=mcu-update/remote-handler
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
ExecStart=/run/media/mmcblk0p6/mcu-update/bin/mcu-updater
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
